# Example only. Node does not load this file automatically.
# Use Node 22+: node --env-file=.env server.mjs
# Never commit .env or copy a server key into browser JavaScript.
EDU_AIGC_API_KEY=
EDU_AIGC_API_URL=https://openrouter.ai/api/v1/chat/completions
# Set the exact provider model ID you are authorized to use.
EDU_AIGC_MODEL=
# Optional comma-separated allowlist; defaults to EDU_AIGC_MODEL.
EDU_AIGC_ALLOWED_MODELS=
EDU_AIGC_TIMEOUT_MS=30000
EDU_AIGC_MAX_OUTPUT_TOKENS=4096
EDU_AIGC_MAX_CONCURRENT=2
# Optional exact origins for an explicitly configured reverse proxy.
# Local same-origin requests do not require this setting.
EDU_AIGC_ALLOWED_ORIGINS=
PORT=3285
