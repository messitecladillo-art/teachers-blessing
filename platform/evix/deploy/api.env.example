# Production template: inject through your process manager or secret store.
# Replace all REPLACE values. Never commit a filled copy.
EVIX_MODE=production
EVIX_DATABASE_URL=postgresql+psycopg://evix_app:REPLACE@postgres:5432/evix
EVIX_ALLOWED_ORIGINS=["https://REPLACE.example.com"]
EVIX_INVITED_EMAILS=["REPLACE@example.com"]
EVIX_AUTH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
EVIX_KEYRING={"v1":"REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS"}
EVIX_ACTIVE_KEY_ID=v1
EVIX_COOKIE_NAME=__Host-evix_session
EVIX_MAIL_MODE=resend
EVIX_PROVIDER_MODE=live
EVIX_MAIL_API_KEY=REPLACE
EVIX_MAIL_FROM=REPLACE@example.com
EVIX_COMPATIBLE_BASES=[]
# Optional PDF compiler: preinstall XeLaTeX, CTeX packages and Chinese fonts.
# Keep empty to disable PDF compilation. The API never installs packages.
EVIX_LATEX_COMPILER=
EVIX_LATEX_TIMEOUT_SECONDS=45
EVIX_LATEX_CONCURRENCY=2
EVIX_LATEX_HOURLY_COMPILES=30
# Research canvas: operator-controlled fixed executor, never a user script.
EVIX_WORKFLOW_ENABLED=false
EVIX_WORKFLOW_EXECUTION_PROFILE=first_release
# Optional Celery adapter only; the default worker consumes PostgreSQL outbox rows.
# EVIX_WORKFLOW_BROKER_URL=amqp://REPLACE:REPLACE@rabbitmq:5672//
EVIX_WORKFLOW_NODE_EXECUTABLE=/usr/local/bin/node
EVIX_WORKFLOW_EXECUTOR_PATH=/srv/evix/apps/evi-x-platform/scripts/workflow-executor.mjs
EVIX_WORKFLOW_CATALOG_PATH=/srv/evix/packages/evi-x-shared/src/workflow-catalog.json
EVIX_WORKFLOW_PARALLEL_COMPUTE=4
EVIX_WORKFLOW_PARALLEL_MODEL=2
EVIX_WORKFLOW_LEASE_SECONDS=240
EVIX_WORKFLOW_NODE_SECONDS=45
# Migration job only, never inject the owner URL into the API process:
# EVIX_MIGRATION_DATABASE_URL=postgresql+psycopg://evix_owner:REPLACE@postgres:5432/evix
